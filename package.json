    "@supabase/supabase-js": "^2.112.3",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.3"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "$sharp"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
