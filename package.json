  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "npm run clean:next && next dev",
    "clean:next": "node scripts/clean-next-cache.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run test && npm run typecheck && npm run build",
    "build": "next build",
    "start": "next start",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "android:build:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-debug-build.ps1",
    "android:doctor": "cap doctor android",
    "auth:migrate-operator-metadata": "node --env-file=.env.local scripts/migrate-operator-auth-metadata.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
